[Unit]
Description=Keychestra — keyboard SoundFont jam overlay (non-blocking)
After=default.target

[Service]
Type=simple
WorkingDirectory=%h/clone/Keychestra
ExecStart=%h/clone/Keychestra/.venv/bin/python -m keychestra
Restart=on-failure
RestartSec=2
Environment=DISPLAY=:1
Environment=XAUTHORITY=%h/.Xauthority
Environment=XDG_RUNTIME_DIR=/run/user/%U

[Install]
WantedBy=default.target
