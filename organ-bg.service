[Unit]
Description=OrganBgWorker — keyboard organ overlay (non-blocking)
After=default.target sound.target

[Service]
Type=simple
WorkingDirectory=%h/clone/OrganBgWorker
ExecStart=%h/clone/OrganBgWorker/.venv/bin/python -m organ_bg
Restart=on-failure
RestartSec=2
Environment=DISPLAY=:1
Environment=XAUTHORITY=%h/.Xauthority

# Needed so pynput can talk to the X session when started from systemd
Environment=XDG_RUNTIME_DIR=/run/user/%U

[Install]
WantedBy=default.target
